{
    // Barra waybar (variante Ubuntu): minimalista por decisión —
    // workspaces+ventana | reloj | bandeja+red+audio.
    // Red: módulo nativo de waybar (nm-applet de noble no registra SNI;
    // verificado: probado con Wayland, env del compositor y X11). El menú
    // completo de redes lo abre nm-connection-editor (network-manager-gnome)
    // al hacer click. Bluetooth: blueman-applet vía autostart con guard.
    // Glifos FontAwesome transplantados byte a byte desde la config legacy
    // (fonts-font-awesome). Ver MIGRATION-ubuntu.md.
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 0,
    "margin-top": 6,
    "margin-bottom": 6,
    "margin-left": 10,
    "margin-right": 7,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "network", "pulseaudio"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
        // Sin persistent-workspaces a propósito: Hyprland crea workspaces
        // perezosamente (existen solo con ventanas), así la barra muestra
        // únicamente los que tienen ventanas + el activo — réplica de la
        // vieja i3bar. La rueda sobre el módulo rota workspaces (default
        // del módulo). El esquema 1..12 por letras vive en bindings.lua.
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "tooltip": false
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ipaddr}",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-bluetooth-muted": " {icon} ",
        // glifo + "muted": el módulo nunca desaparece al mutear
        // (bug de la config original: format-muted vacío)
        "format-muted": " muted",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {"headphone": "", "hands-free": "", "headset": "", "phone": "", "portable": "", "car": "", "default": ["", "", ""]},
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "clock": {
        "timezone": "",
        "format": " {:%H:%M}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
